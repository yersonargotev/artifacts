---
import { getRuntime } from '../runtime.ts';
import { artifactErrorResponse, panelActor } from '../publication.ts';
import { libraryHref, pageOffset, readLibraryUrl, readListGroup, readListOffset, readListView, readerHref, viewCookie } from '../urls.ts';
import { locationOf, projectTone, searchFor } from '../presentation.ts';
import Panel from '../layouts/Panel.astro';
import '../styles/views.css';
import LibraryHeading from '../components/library/LibraryHeading.astro';
import LibraryFilters from '../components/library/LibraryFilters.astro';
import PendingBanner from '../components/library/PendingBanner.astro';
import ArtifactGrid from '../components/library/ArtifactGrid.astro';
import SharedWithMe from '../components/library/SharedWithMe.astro';
import Icon from '../components/Icon.astro';
const identity = Astro.locals.identity;
const { panel, artifacts } = await getRuntime();
const failed = Astro.url.searchParams.get('login') === 'failed';
const revoked = Astro.url.searchParams.has('revoked');
let query;
try { query = readLibraryUrl(Astro.url); }
catch (error) { return artifactErrorResponse(error); }
const { view, named: namedView } = readListView(Astro.url, Astro.cookies.get(viewCookie)?.value);
const actor = identity && panelActor(identity);
const snapshot = actor ? await panel.library(actor, query).catch(artifactErrorResponse) : undefined;
if (snapshot instanceof Response) return snapshot;
const shared = actor && query.scope.kind === 'all' && !query.q && query.status === 'all' && !query.cursor ? await artifacts.listSharedWithMe(actor).catch(artifactErrorResponse) : { items: [] };
if (shared instanceof Response) return shared;
const scope = snapshot?.page.scope;
const pendingTally = !snapshot || !scope ? 0 : scope.kind === 'all' ? snapshot.workspace.total.pending : scope.kind === 'project' ? scope.project.pending : scope.kind === 'unfiled' ? scope.tally.pending : 0;
// The banner reads the scope's most recently updated pending artifact, whatever the page's own filters are.
const pending = actor && pendingTally > 0 ? await panel.library(actor, { scope: query.scope, status: 'pending', q: '' }).catch(artifactErrorResponse) : undefined;
if (pending instanceof Response) return pending;
const link = snapshot && searchFor(snapshot.page, { view: namedView, group: readListGroup(Astro.url) });
const project = scope?.kind === 'project' ? scope.project.name : scope?.kind === 'vanishedProject' ? scope.name : undefined;
const title = scope?.kind === 'unfiled' ? 'Sin proyecto' : project ?? 'Biblioteca';
const offset = snapshot && pageOffset(readListOffset(Astro.url), snapshot.page);
const paletteArtifacts = snapshot && link ? snapshot.page.cards.map((card) => ({ title: card.title, project: card.project, tone: card.project ? projectTone(card.project) : undefined, href: readerHref(link, { cursor: query.cursor, offset, artifactId: card.artifactId }) })) : [];
---
<Panel share move flush={Boolean(snapshot)} title={title} workspace={snapshot?.workspace} location={scope ? locationOf(scope) : undefined} search={link} artifacts={paletteArtifacts} readerKey={Boolean(link)}>
  {link && <a slot="bar" class="button secondary reader-link" href={readerHref(link)}><Icon name="book" size={16} /><span>Modo lectura</span><kbd class="kbd" data-key-hint="reader" aria-hidden="true" hidden>r</kbd></a>}
  {snapshot && <Fragment slot="status">
    <span data-key-hint="move" hidden><kbd class="kbd">j</kbd> <kbd class="kbd">k</kbd> mover</span>
    <span data-key-hint="read" hidden><kbd class="kbd">↵</kbd> leer</span>
    <span data-key-hint="publish" hidden><kbd class="kbd">p</kbd> publicar</span>
    <span data-key-hint="theme" hidden><kbd class="kbd">t</kbd> tema</span>
  </Fragment>}
  {snapshot && link ? <>
    <LibraryHeading scope={snapshot.page.scope} />
    <SharedWithMe items={shared.items} />
    {snapshot.workspace.total.count === 0 && shared.items.length > 0 && <p class="library-note">Aún no tienes artefactos propios. <a href="#connect-tools" data-open-tools>Conectar herramientas</a></p>}
    {(snapshot.workspace.total.count > 0 || shared.items.length === 0) && <>
      <LibraryFilters workspace={snapshot.workspace} page={snapshot.page} query={link} view={view} />
      {pending?.page.cards[0] && <PendingBanner card={pending.page.cards[0]} count={pending.page.counts.pending} pendingHref={libraryHref(link, { status: 'pending' })} />}
      <ArtifactGrid page={snapshot.page} workspace={snapshot.workspace} query={link} cursor={query.cursor} offset={offset} now={new Date()} view={view} />
    </>}
  </> : <section class="welcome logged-out"><div class="welcome-mark" aria-hidden="true"><Icon name="layers-intersect" size={48} /></div><h1>Un espacio propio<br />para lo que creas.</h1><p>Entra a tu cuenta para ver tus artefactos y conectar tus herramientas.</p>{failed && <p role="alert">No se pudo completar el inicio de sesión. Vuelve a intentarlo.</p>}{revoked && <p role="status">Se cerraron todas tus sesiones.</p>}<a class="button" data-variant="primary" href="/auth/login">Iniciar sesión</a></section>}
</Panel>
<script>
  import '../components/library/keys.ts';
  import '../components/shell/views.ts';
</script>
