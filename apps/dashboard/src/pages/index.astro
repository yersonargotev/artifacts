---
import { getRuntime } from '../runtime.ts';
import { panelActor } from '../publication.ts';
import { libraryQuerySchema } from '@artifacts/artifacts/contracts';
import Panel from '../layouts/Panel.astro';
import ArtifactLibrary from '../components/ArtifactLibrary.astro';
import LibrarySidebar from '../components/LibrarySidebar.astro';
import Icon from '../components/Icon.astro';
const identity = Astro.locals.identity;
const { config, artifacts } = await getRuntime();
const failed = Astro.url.searchParams.get('login') === 'failed';
const revoked = Astro.url.searchParams.has('revoked');
const status = libraryQuerySchema.shape.status.safeParse(Astro.url.searchParams.get('status') ?? undefined);
const parsed = libraryQuerySchema.safeParse({ q: Astro.url.searchParams.get('q') ?? undefined, status: status.success ? status.data : 'all', cursor: Astro.url.searchParams.get('cursor') ?? undefined });
if (!parsed.success) return new Response('Los parámetros de búsqueda no son válidos.', { status: 400 });
const query = parsed.data;
const listed = identity ? await artifacts.queryLibrary(panelActor(identity), query) : undefined;
---
<Panel library={Boolean(identity)}>
  {identity && <LibrarySidebar slot="sidebar" identity={identity} authUrl={config.auth} />}
  {identity && <header slot="header" class="workspace-toolbar"><span class="workspace-breadcrumb"><Icon name="layout-dashboard" size={17} />Espacio de trabajo<Icon name="chevron-right" size={14} /><span>Biblioteca</span></span><span class="session-indicator">Sesión activa</span></header>}
  {identity ? <ArtifactLibrary page={listed!} query={query} /> : <section class="welcome logged-out"><div class="welcome-mark" aria-hidden="true"><Icon name="layers-intersect" size={48} /></div><h1>Un espacio propio<br />para lo que creas.</h1><p>Entra a tu cuenta para ver tus artefactos y conectar tus herramientas.</p>{failed && <p role="alert">No se pudo completar el inicio de sesión. Vuelve a intentarlo.</p>}{revoked && <p role="status">Se cerraron todas tus sesiones.</p>}<a class="button" href="/auth/login">Iniciar sesión</a></section>}
</Panel>
