---
import { getRuntime } from '../../runtime.ts';
import { artifactErrorResponse, panelActor } from '../../publication.ts';
import { historySchema, readSchema } from '@artifacts/artifacts/contracts';
import Panel from '../../layouts/Panel.astro';
if (!Astro.locals.identity) return Astro.redirect(`/auth/login?${new URLSearchParams({ returnTo: `${Astro.url.pathname}${Astro.url.search}` })}`, 303);
const store = (await getRuntime()).artifacts;
const actor = panelActor(Astro.locals.identity);
const input = readSchema.parse({ artifactId: Astro.params.artifactId, revisionId: Astro.url.searchParams.get('revisionId') ?? undefined });
const result = await Promise.all([store.read(actor, input), store.history(actor, historySchema.parse({ artifactId: input.artifactId, beforeSequence: Astro.url.searchParams.has('before') ? Number(Astro.url.searchParams.get('before')) : undefined }))]).catch((error: unknown) => artifactErrorResponse(error));
if (result instanceof Response) return result;
const [artifact, history] = result;
const { revision, publication } = artifact;
const revisionUrl = (revisionId: string, action = '') => `/artifacts/${encodeURIComponent(artifact.artifactId)}${action}?${new URLSearchParams({ revisionId })}`;
---
<Panel title={revision.snapshot.metadata.title} section="Tu artefacto">
  <a class="back" href="/">Volver a tu espacio</a>
  <section class="welcome"><h1>{revision.snapshot.metadata.title}</h1><p>{revision.snapshot.metadata.description}</p></section>
  <section class="publication"><h2>Publicación actual</h2>{publication ? <><p>Versión {publication.version}. El enlace conserva la dirección cuando publicas otra revisión.</p><a class="button" href={publication.url}>Abrir publicación</a><code>{publication.url}</code></> : <p class="muted">Este artefacto aún no está publicado. Puedes publicarlo desde tus herramientas.</p>}</section>
  <section><div class="revision-title"><h2>Revisión {revision.sequence}</h2>{revision.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{revision.id === publication?.revisionId && <span class="badge">Publicada</span>}</div><p class="muted">Creada el {new Date(revision.createdAt).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })} UTC.</p><div class="actions"><a class="secondary button" href={revisionUrl(revision.id, '/export')}>Descargar revisión {revision.sequence}</a></div><iframe class="preview" title={`Vista previa de la revisión ${revision.sequence}`} sandbox="allow-scripts" referrerpolicy="no-referrer" src={revisionUrl(revision.id, '/preview')}></iframe><dl><dt>Revisión</dt><dd>{revision.id}</dd><dt>Cliente autor</dt><dd>{revision.authorClientId}</dd><dt>SHA-256</dt><dd>{revision.sha256}</dd></dl></section>
  <section class="artifacts"><h2>Historial</h2><p>Cada revisión conserva el contenido completo y los archivos que tenía al guardarse.</p><ol class="revision-list">{history.items.map((item) => <li><div class="revision-title"><h3>Revisión {item.sequence}</h3>{item.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{item.id === publication?.revisionId && <span class="badge">Publicada</span>}</div><p>{item.snapshot.metadata.title}</p><p>{new Date(item.createdAt).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })} UTC · {item.authorClientId}</p><div class="actions"><a href={revisionUrl(item.id)}>Ver revisión {item.sequence}</a><a href={revisionUrl(item.id, '/export')}>Descargar revisión {item.sequence}</a></div></li>)}</ol>{history.nextBeforeSequence && <a href={`/artifacts/${encodeURIComponent(artifact.artifactId)}?${new URLSearchParams({ before: String(history.nextBeforeSequence) })}`}>Ver revisiones anteriores</a>}</section>
</Panel>
