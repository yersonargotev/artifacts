---
import { getRuntime } from '../../runtime.ts';
import { artifactErrorResponse, panelActor } from '../../publication.ts';
import { retainedMarkers } from '../../presentation.ts';
import { readDetailUrl, detailQuery } from '../../urls.ts';
import { summarizeRevision } from '@artifacts/artifacts/workflow';
import Panel from '../../layouts/Panel.astro';
import DetailHeader from '../../components/detail/DetailHeader.astro';
import DetailTabs from '../../components/detail/DetailTabs.astro';
import PreviewCard from '../../components/detail/PreviewCard.astro';
import FilesPanel from '../../components/detail/FilesPanel.astro';
import ComparePanel from '../../components/detail/ComparePanel.astro';
import InformationPanel from '../../components/detail/InformationPanel.astro';
import PublicationCard from '../../components/detail/PublicationCard.astro';
import HistoryCard from '../../components/detail/HistoryCard.astro';
import FactsCard from '../../components/detail/FactsCard.astro';
if (!Astro.locals.identity) return Astro.redirect(`/auth/login?${new URLSearchParams({ returnTo: `${Astro.url.pathname}${Astro.url.search}` })}`, 303);
const { panel } = await getRuntime();
const result = await (async () => {
  const url = readDetailUrl(Astro.params.artifactId, Astro.url);
  return { ...await panel.artifact(panelActor(Astro.locals.identity!), detailQuery(url)), url };
})().catch(artifactErrorResponse);
if (result instanceof Response) return result;
const { workspace, detail } = result;
const url = { ...result.url, revisionId: detail.selected.revision.id, compareTo: detail.compared?.revisionId };
const summary = url.tab === 'files' ? await summarizeRevision(detail.selected.revision) : undefined;
---
<Panel title={detail.selected.revision.snapshot.metadata.title} workspace={workspace} location={{ kind: 'artifact', project: detail.project }} detail>
  <section class="artifact-detail" {...retainedMarkers(detail)}>
    <DetailHeader detail={detail} url={{ ...url, compareTo: result.url.compareTo }} />
    <DetailTabs url={url} fileCount={detail.selected.revision.snapshot.files.length} />
    <div class="detail-body">
      <div class="detail-main">
        {url.tab === 'preview' && <PreviewCard detail={detail} />}
        {summary && <FilesPanel files={summary.files} sequence={detail.selected.revision.sequence} />}
        {url.tab === 'compare' && <ComparePanel detail={detail} url={url} />}
        {url.tab === 'information' && <InformationPanel detail={detail} />}
      </div>
      <aside class="detail-aside"><PublicationCard detail={detail} url={url} /><HistoryCard detail={detail} url={url} /><FactsCard detail={detail} /></aside>
    </div>
  </section>
</Panel>
<script>
  import '../../components/detail/detail.ts';
</script>
