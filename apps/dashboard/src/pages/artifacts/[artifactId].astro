---
import { getRuntime } from '../../runtime.ts';
import { artifactErrorResponse, panelActor } from '../../publication.ts';
import { loadArtifactReview } from '../../review.ts';
import PublicationForm from '../../components/PublicationForm.astro';
import Panel from '../../layouts/Panel.astro';
if (!Astro.locals.identity) return Astro.redirect(`/auth/login?${new URLSearchParams({ returnTo: `${Astro.url.pathname}${Astro.url.search}` })}`, 303);
const result = await getRuntime().then(({ artifacts }) => loadArtifactReview(artifacts, panelActor(Astro.locals.identity!), Astro.params.artifactId, Astro.url.searchParams)).catch((error: unknown) => artifactErrorResponse(error));
if (result instanceof Response) return result;
const { artifact, history, head, published, compared, summary, comparison, revisions, before } = result;
const { revision, publication } = artifact;
const revisionUrl = (revisionId: string, action = '', compareTo = compared?.id) => `/artifacts/${encodeURIComponent(artifact.artifactId)}${action}?${new URLSearchParams({ revisionId, ...(!action && compareTo && compareTo !== revisionId ? { compareTo } : {}) })}`;
const command = { artifactId: artifact.artifactId, revisionId: revision.id, expectedPublicationVersion: publication?.version ?? 0, requestId: crypto.randomUUID() };
const pending = publication && publication.revisionId !== artifact.headRevisionId;
const date = (value: string) => new Date(value).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' });
const metadataLabels = { title: 'Título', description: 'Descripción', custom: 'Metadatos personalizados' };
const fileLabels = { added: 'Agregado', removed: 'Eliminado', changed: 'Modificado' };
const metadataValue = (value: unknown) => value === undefined ? 'Sin valor' : typeof value === 'string' ? value : JSON.stringify(value, null, 2);
---
<Panel title={revision.snapshot.metadata.title} section="Tu artefacto">
<section class="artifact-detail" data-artifact-id={artifact.artifactId} data-revision-id={revision.id} data-revision-sha256={revision.sha256} data-publication-version={publication?.version ?? 0}>
  <a class="back" href="/">Volver a tu espacio</a>
  <section class="welcome"><h1>{revision.snapshot.metadata.title}</h1><p>{revision.snapshot.metadata.description}</p></section>
  <section class="publication">
    <h2>Revisiones y publicación</h2>
    <dl class="revision-state"><dt>Seleccionada</dt><dd><a href={revisionUrl(revision.id)}>Revisión {revision.sequence}</a><code>{revision.id}</code></dd><dt>Más reciente</dt><dd><a href={revisionUrl(head.id)}>Revisión {head.sequence}</a><code>{head.id}</code></dd><dt>Publicada</dt><dd>{published ? <><a href={revisionUrl(published.id)}>Revisión {published.sequence}</a><code>{published.id}</code></> : 'Sin publicar'}</dd></dl>
    {publication ? <><p>Versión {publication.version}. El enlace conserva la dirección cuando publicas otra revisión.</p><p class="publication-state">{pending ? 'Hay cambios pendientes de publicación en la revisión más reciente.' : 'La revisión más reciente está publicada.'}</p><a class="secondary button" href={publication.url}>Abrir publicación</a><code>{publication.url}</code></> : <p class="muted">Este artefacto aún no está publicado.</p>}
    <p>Publicar crea un enlace protegido a la revisión seleccionada y sus archivos. Solo la cuenta propietaria autenticada puede abrirlo.</p>
    <PublicationForm command={command} label={`Publicar revisión ${revision.sequence}`} />
  </section>
  <section><div class="revision-title"><h2>Revisión {revision.sequence}</h2>{revision.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{revision.id === publication?.revisionId && <span class="badge">Publicada</span>}</div><p class="muted">Creada el {date(revision.createdAt)} UTC.</p><div class="actions"><a class="secondary button" href={revisionUrl(revision.id, '/export')}>Descargar revisión {revision.sequence}</a></div><iframe class="preview" title={`Vista previa de la revisión ${revision.sequence}`} sandbox="allow-scripts" referrerpolicy="no-referrer" src={revisionUrl(revision.id, '/preview')}></iframe><dl><dt>Revisión</dt><dd>{revision.id}</dd><dt>Cliente autor</dt><dd>{revision.authorClientId}</dd><dt>SHA-256</dt><dd>{revision.sha256}</dd></dl></section>
  <section class="inventory"><h2>Archivos de la revisión {revision.sequence}</h2><p>La descarga de esta revisión incluye estos archivos con sus bytes originales.</p>{summary.files.length ? <div class="table-scroll"><table><thead><tr><th scope="col">Archivo</th><th scope="col">Tipo y codificación</th><th scope="col">Bytes</th><th scope="col">SHA-256</th></tr></thead><tbody>{summary.files.map((file) => <tr><th scope="row">{file.path}</th><td>{file.mediaType}<br />{file.encoding}</td><td>{file.decodedBytes}</td><td><code>{file.sha256}</code></td></tr>)}</tbody></table></div> : <p class="muted">Esta revisión no tiene archivos adjuntos.</p>}</section>
  <section class="comparison">
    <h2>Comparar revisiones</h2>
    {revisions.length > 0 && <form class="compare-form" method="get" action={Astro.url.pathname}><input type="hidden" name="revisionId" value={revision.id} />{before && <input type="hidden" name="before" value={before} />}<label for="compareTo">Comparar la seleccionada con</label><select id="compareTo" name="compareTo">{revisions.map((item) => <option value={item.id} selected={item.id === compared?.id}>Revisión {item.sequence}{item.id === published?.id ? ' · publicada' : ''}{item.id === head.id ? ' · más reciente' : ''}</option>)}</select><button class="secondary">Comparar</button></form>}
    {comparison && compared ? <>
      <p>De la <a href={revisionUrl(compared.id)}>revisión {compared.sequence}</a> a la seleccionada, revisión {revision.sequence}.</p>
      <h3>Metadatos</h3>{comparison.metadata.length ? <div class="table-scroll"><table><thead><tr><th scope="col">Campo</th><th scope="col">Revisión {compared.sequence}</th><th scope="col">Seleccionada, revisión {revision.sequence}</th></tr></thead><tbody>{comparison.metadata.map((row) => <tr><th scope="row">{metadataLabels[row.field]}</th><td><pre>{metadataValue(row.before)}</pre></td><td><pre>{metadataValue(row.after)}</pre></td></tr>)}</tbody></table></div> : <p class="muted">Los metadatos no cambiaron.</p>}
      <h3>Contenido</h3><p>{comparison.content.kindChanged ? `El formato cambió de ${comparison.content.before.kind} a ${comparison.content.after.kind}.` : `Formato ${comparison.content.after.kind}.`}{comparison.content.textChanged ? ' El texto cambió.' : ' El texto no cambió.'}</p><div class="content-comparison"><div><h4>Revisión {compared.sequence}</h4><pre>{comparison.content.before.text}</pre></div><div><h4>Seleccionada, revisión {revision.sequence}</h4><pre>{comparison.content.after.text}</pre></div></div>
      <h3>Archivos</h3>{comparison.files.length ? <ul class="file-changes">{comparison.files.map((row) => <li><h4>{row.path} <span class="badge">{fileLabels[row.change]}</span></h4><div class="file-comparison">{[{ label: `Revisión ${compared.sequence}`, file: row.before }, { label: `Seleccionada, revisión ${revision.sequence}`, file: row.after }].map(({ label, file }) => <div><p>{label}</p>{file ? <><p>{file.mediaType} · {file.encoding} · {file.decodedBytes} bytes</p><code>{file.sha256}</code></> : <p class="muted">Sin archivo</p>}</div>)}</div></li>)}</ul> : <p class="muted">Los archivos no cambiaron.</p>}
    </> : <p class="muted">No hay otra revisión disponible para comparar.</p>}
  </section>
  <section class="artifacts"><h2>Historial</h2><p>Cada revisión conserva el contenido completo y los archivos que tenía al guardarse.</p><ol class="revision-list">{history.items.map((item) => <li><div class="revision-title"><h3>Revisión {item.sequence}</h3>{item.id === revision.id && <span class="badge">Seleccionada</span>}{item.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{item.id === publication?.revisionId && <span class="badge">Publicada</span>}</div><p>{item.snapshot.metadata.title}</p><p>{date(item.createdAt)} UTC · {item.authorClientId}</p><div class="actions"><a href={revisionUrl(item.id)}>Ver revisión {item.sequence}</a>{item.id !== revision.id && <a href={revisionUrl(revision.id, '', item.id)}>Comparar con revisión {item.sequence}</a>}<a href={revisionUrl(item.id, '/export')}>Descargar revisión {item.sequence}</a></div></li>)}</ol>{history.nextBeforeSequence && <a href={`/artifacts/${encodeURIComponent(artifact.artifactId)}?${new URLSearchParams({ revisionId: revision.id, ...(compared ? { compareTo: compared.id } : {}), before: String(history.nextBeforeSequence) })}`}>Ver revisiones anteriores</a>}</section>
</section>
</Panel>
