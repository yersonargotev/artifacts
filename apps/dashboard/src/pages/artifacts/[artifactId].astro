---
import { getRuntime } from '../../runtime.ts';
import { artifactErrorResponse, panelActor } from '../../publication.ts';
import { loadArtifactReview } from '../../review.ts';
import PublicationForm from '../../components/PublicationForm.astro';
import ArtifactTitleMenu from '../../components/ArtifactTitleMenu.tsx';
import Panel from '../../layouts/Panel.astro';
import LibrarySidebar from '../../components/LibrarySidebar.astro';
import Icon from '../../components/Icon.astro';
if (!Astro.locals.identity) return Astro.redirect(`/auth/login?${new URLSearchParams({ returnTo: `${Astro.url.pathname}${Astro.url.search}` })}`, 303);
const { config, artifacts } = await getRuntime();
const actor = panelActor(Astro.locals.identity);
const result = await Promise.all([loadArtifactReview(artifacts, actor, Astro.params.artifactId, Astro.url.searchParams), artifacts.projects(actor)]).catch((error: unknown) => artifactErrorResponse(error));
if (result instanceof Response) return result;
const [{ artifact, history, head, published, compared, summary, comparison, revisions, before }, projects] = result;
const { revision, publication } = artifact;
const revisionUrl = (revisionId: string, action = '', compareTo = compared?.id) => `/artifacts/${encodeURIComponent(artifact.artifactId)}${action}?${new URLSearchParams({ revisionId, ...(!action && compareTo && compareTo !== revisionId ? { compareTo } : {}) })}`;
const command = { artifactId: artifact.artifactId, revisionId: revision.id, expectedPublicationVersion: publication?.version ?? 0, requestId: crypto.randomUUID() };
const selectionOptions = [revision, ...revisions].sort((a, b) => b.sequence - a.sequence);
const explicitComparison = Astro.url.searchParams.get('compareTo');
const selectedPublication = publication?.revisionId === revision.id ? publication : undefined;
const pending = publication && publication.revisionId !== artifact.headRevisionId;
const date = (value: string) => new Date(value).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' });
const metadataLabels = { title: 'Título', description: 'Descripción', custom: 'Metadatos personalizados' };
const fileLabels = { added: 'Agregado', removed: 'Eliminado', changed: 'Modificado' };
const metadataValue = (value: unknown) => value === undefined ? 'Sin valor' : typeof value === 'string' ? value : JSON.stringify(value, null, 2);
---
<Panel title={revision.snapshot.metadata.title} section="Tu artefacto" library detail>
<LibrarySidebar slot="sidebar" identity={Astro.locals.identity} authUrl={config.auth} projects={projects.items} project={artifact.project ?? undefined} active={false} />
<header slot="header" class="artifact-toolbar">
  <a class="home-link" href="/" aria-label="Volver a tus artefactos"><Icon name="arrow-left" size={20} /></a>
  <h1><ArtifactTitleMenu title={revision.snapshot.metadata.title} revisionLabel={`Revisión ${revision.sequence}`} actions={[
    { label: `Descargar revisión ${revision.sequence}`, href: revisionUrl(revision.id, '/export'), icon: 'download', group: 'revision' },
    { label: 'Información', href: '#information', icon: 'information', group: 'sections' },
    { label: `Archivos (${summary.files.length})`, href: '#files', icon: 'files', group: 'sections' },
    { label: 'Comparar revisiones', href: '#comparison', icon: 'comparison', group: 'sections' },
    { label: 'Historial', href: '#history', icon: 'history', group: 'sections' },
    { label: 'Tus artefactos', href: '/', icon: 'library', group: 'destinations' },
    ...(publication ? [{ label: 'Abrir publicación', href: publication.url, icon: 'publication' as const, group: 'destinations' as const }] : []),
  ]} client:load /></h1>
  <span class="toolbar-revision">Revisión {revision.sequence}</span>
  {selectedPublication ? <a class="button" href={selectedPublication.url}>Abrir publicación</a> : <PublicationForm command={command} label={`Publicar revisión ${revision.sequence}`} />}
</header>
<section class="artifact-detail" data-artifact-id={artifact.artifactId} data-revision-id={revision.id} data-revision-sha256={revision.sha256} data-publication-version={publication?.version ?? 0}>
  <div class="review-controls">
  <form class="revision-select" method="get" action={Astro.url.pathname}>
    {before && <input type="hidden" name="before" value={before} />}
    {explicitComparison && <input type="hidden" name="compareTo" value={explicitComparison} />}
    <label for="revisionId">Revisión seleccionada</label>
    <select id="revisionId" name="revisionId">{selectionOptions.map((item) => <option value={item.id} selected={item.id === revision.id}>Revisión {item.sequence}{item.id === published?.id ? ' · publicada' : ''}{item.id === head.id ? ' · más reciente' : ''}</option>)}</select>
    <button class="secondary">Ver revisión</button>
  </form>
  <dl class="revision-state"><div><dt>Seleccionada</dt><dd><a href={revisionUrl(revision.id)}>Revisión {revision.sequence}</a></dd></div><div><dt>Más reciente</dt><dd><a href={revisionUrl(head.id)}>Revisión {head.sequence}</a></dd></div><div><dt>Publicada</dt><dd>{published ? <a href={revisionUrl(published.id)}>Revisión {published.sequence}</a> : 'Sin publicar'}</dd></div></dl>
  <p class="publication-state">{publication ? pending ? 'Hay cambios pendientes de publicación en la revisión más reciente.' : 'La revisión más reciente está publicada.' : 'Este artefacto aún no está publicado.'}</p>
  </div>
  <section class="selected-preview">
    <div class="preview-heading"><span><Icon name="file-text" size={16} />Vista previa</span><span>Revisión {revision.sequence}<span class="format-badge">{revision.snapshot.content.kind}</span></span></div>
    <iframe class="preview" title={`Vista previa de la revisión ${revision.sequence}`} sandbox="allow-scripts" referrerpolicy="no-referrer" src={revisionUrl(revision.id, '/preview')}></iframe>
    <details class="artifact-info" id="information">
      <summary>Información</summary>
      <h2>Revisión {revision.sequence}</h2>
      {revision.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{selectedPublication && <span class="badge">Publicada</span>}
      <dl><dt>Título</dt><dd>{revision.snapshot.metadata.title}</dd><dt>Descripción</dt><dd>{revision.snapshot.metadata.description}</dd>{revision.snapshot.metadata.custom !== undefined && <><dt>Metadatos personalizados</dt><dd><pre>{JSON.stringify(revision.snapshot.metadata.custom, null, 2)}</pre></dd></>}<dt>Artefacto</dt><dd>{artifact.artifactId}</dd><dt>Proyecto</dt><dd>{artifact.project ?? 'Sin proyecto'}</dd><dt>Revisión</dt><dd>{revision.id}</dd><dt>Cliente autor</dt><dd>{revision.authorClientId}</dd><dt>Creada</dt><dd>{date(revision.createdAt)} UTC</dd><dt>SHA-256</dt><dd>{revision.sha256}</dd></dl>
      {publication && <><p>Versión {publication.version}. El enlace conserva la dirección cuando publicas otra revisión.</p><code>{publication.url}</code></>}
      <p>Publicar crea un enlace protegido a la revisión seleccionada y sus archivos. Solo la cuenta propietaria autenticada puede abrirlo.</p>
    </details>
  </section>
  <nav class="section-links" aria-label="Secciones de la revisión"><a href="#files">Archivos ({summary.files.length})</a><a href="#comparison">Comparar revisiones</a><a href="#history">Historial</a></nav>
  <section class="inventory" id="files"><h2 tabindex="-1">Archivos de la revisión {revision.sequence}</h2><p>La descarga de esta revisión incluye estos archivos con sus bytes originales.</p>{summary.files.length ? <div class="table-scroll"><table><thead><tr><th scope="col">Archivo</th><th scope="col">Tipo y codificación</th><th scope="col">Bytes</th><th scope="col">SHA-256</th></tr></thead><tbody>{summary.files.map((file) => <tr><th scope="row">{file.path}</th><td>{file.mediaType}<br />{file.encoding}</td><td>{file.decodedBytes}</td><td><code>{file.sha256}</code></td></tr>)}</tbody></table></div> : <p class="muted">Esta revisión no tiene archivos adjuntos.</p>}</section>
  <section class="comparison" id="comparison">
    <h2 tabindex="-1">Comparar revisiones</h2>
    {revisions.length > 0 && <form class="compare-form" method="get" action={Astro.url.pathname}><input type="hidden" name="revisionId" value={revision.id} />{before && <input type="hidden" name="before" value={before} />}<label for="compareTo">Comparar la seleccionada con</label><select id="compareTo" name="compareTo">{revisions.map((item) => <option value={item.id} selected={item.id === compared?.id}>Revisión {item.sequence}{item.id === published?.id ? ' · publicada' : ''}{item.id === head.id ? ' · más reciente' : ''}</option>)}</select><button class="secondary">Comparar</button></form>}
    {comparison && compared ? <>
      <p>De la <a href={revisionUrl(compared.id)}>revisión {compared.sequence}</a> a la seleccionada, revisión {revision.sequence}.</p>
      <h3>Metadatos</h3>{comparison.metadata.length ? <div class="table-scroll"><table><thead><tr><th scope="col">Campo</th><th scope="col">Revisión {compared.sequence}</th><th scope="col">Seleccionada, revisión {revision.sequence}</th></tr></thead><tbody>{comparison.metadata.map((row) => <tr><th scope="row">{metadataLabels[row.field]}</th><td><pre>{metadataValue(row.before)}</pre></td><td><pre>{metadataValue(row.after)}</pre></td></tr>)}</tbody></table></div> : <p class="muted">Los metadatos no cambiaron.</p>}
      <h3>Contenido</h3><p>{comparison.content.kindChanged ? `El formato cambió de ${comparison.content.before.kind} a ${comparison.content.after.kind}.` : `Formato ${comparison.content.after.kind}.`}{comparison.content.textChanged ? ' El texto cambió.' : ' El texto no cambió.'}</p><div class="content-comparison"><div><h4>Revisión {compared.sequence}</h4><pre>{comparison.content.before.text}</pre></div><div><h4>Seleccionada, revisión {revision.sequence}</h4><pre>{comparison.content.after.text}</pre></div></div>
      <h3>Archivos</h3>{comparison.files.length ? <ul class="file-changes">{comparison.files.map((row) => <li><h4>{row.path} <span class="badge">{fileLabels[row.change]}</span></h4><div class="file-comparison">{[{ label: `Revisión ${compared.sequence}`, file: row.before }, { label: `Seleccionada, revisión ${revision.sequence}`, file: row.after }].map(({ label, file }) => <div><p>{label}</p>{file ? <><p>{file.mediaType} · {file.encoding} · {file.decodedBytes} bytes</p><code>{file.sha256}</code></> : <p class="muted">Sin archivo</p>}</div>)}</div></li>)}</ul> : <p class="muted">Los archivos no cambiaron.</p>}
    </> : <p class="muted">No hay otra revisión disponible para comparar.</p>}
  </section>
  <section class="artifacts" id="history"><h2 tabindex="-1">Historial</h2><p>Cada revisión conserva el contenido completo y los archivos que tenía al guardarse.</p><ol class="revision-list">{history.items.map((item) => <li><div class="revision-title"><h3>Revisión {item.sequence}</h3>{item.id === revision.id && <span class="badge">Seleccionada</span>}{item.id === artifact.headRevisionId && <span class="badge">Más reciente</span>}{item.id === publication?.revisionId && <span class="badge">Publicada</span>}</div><p>{item.snapshot.metadata.title}</p><p>{date(item.createdAt)} UTC · {item.authorClientId}</p><div class="actions"><a href={revisionUrl(item.id)}>Ver revisión {item.sequence}</a>{item.id !== revision.id && <a href={revisionUrl(revision.id, '', item.id)}>Comparar con revisión {item.sequence}</a>}<a href={revisionUrl(item.id, '/export')}>Descargar revisión {item.sequence}</a></div></li>)}</ol>{history.nextBeforeSequence && <a href={`/artifacts/${encodeURIComponent(artifact.artifactId)}?${new URLSearchParams({ revisionId: revision.id, ...(compared ? { compareTo: compared.id } : {}), before: String(history.nextBeforeSequence) })}`}>Ver revisiones anteriores</a>}</section>
</section>
</Panel>
