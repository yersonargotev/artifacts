---
import type { LibraryPage } from '@artifacts/artifacts/panel/model';
import { searchFor, statusTabs } from '../../presentation.ts';
import { libraryHref, readerHref, type ListView } from '../../urls.ts';
interface Props { page: LibraryPage; namedView?: ListView; reader?: boolean }
const { page, namedView, reader = false } = Astro.props;
const query = searchFor(page, namedView);
const href = reader ? readerHref : libraryHref;
---
<nav class="library-filters" aria-label="Filtrar por publicación">
  {statusTabs.map(({ value, label }) => <a href={href(query, { status: value })} aria-current={page.status === value ? 'page' : undefined} aria-label={`${label} (${page.counts[value]})`}>{label}<span>{page.counts[value]}</span></a>)}
</nav>
