---
import type { LibraryPage } from '@artifacts/artifacts/panel/model';
import { statusTabs } from '../../presentation.ts';
import { libraryHref, readerHref, type LibraryLink } from '../../urls.ts';
interface Props { page: LibraryPage; query: LibraryLink; reader?: boolean }
const { page, query, reader = false } = Astro.props;
const href = reader ? readerHref : libraryHref;
---
<nav class="library-filters" aria-label="Filtrar por publicación">
  {statusTabs.map((tab) => {
    // The reader's narrow list uses the short label, and the full one stays as the tooltip.
    const label = reader && 'short' in tab ? tab.short : tab.label;
    return <a href={href(query, { status: tab.value })} aria-current={page.status === tab.value ? 'page' : undefined} aria-label={`${label} (${page.counts[tab.value]})`} title={label === tab.label ? undefined : tab.label}>{label}<span>{page.counts[tab.value]}</span></a>;
  })}
</nav>
