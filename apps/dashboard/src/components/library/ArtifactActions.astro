---
import type { ArtifactCard as Card } from '@artifacts/artifacts/panel/model';
import { moveHref, shareHref, exportHref } from '../../urls.ts';
import ArtifactMenu from '../ArtifactMenu.tsx';
interface Props { card: Card }
const { card } = Astro.props;
const detailUrl = `/artifacts/${encodeURIComponent(card.artifactId)}`;
const publication = card.publication.state === 'unpublished' ? undefined : card.publication;
---
<ArtifactMenu title={card.title} revisionLabel={`Revisión ${card.head.sequence}`} actions={JSON.stringify([
  { label: 'Ver artefacto', href: detailUrl },
  { label: 'Compartir', href: shareHref(card.artifactId), share: true },
  { label: 'Descargar revisión más reciente', href: exportHref(card.artifactId, card.head.revisionId) },
  ...(publication ? [{ label: 'Abrir publicación', href: publication.url }] : []),
  { label: 'Mover a proyecto', href: moveHref([card.artifactId]), moveItems: JSON.stringify([{ artifactId: card.artifactId, title: card.title, project: card.project }]) },
])} deleteUrl={`${detailUrl}/delete`} client:load />
<a class="native-share-link" href={shareHref(card.artifactId)} data-share-trigger>Compartir</a>
<noscript><a class="native-move-link" href={moveHref([card.artifactId])}>Mover a proyecto</a></noscript>
