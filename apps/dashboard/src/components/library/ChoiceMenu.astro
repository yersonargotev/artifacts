---
import Icon from '../Icon.astro';
export type MenuLink = { readonly label: string; readonly href: string; readonly current?: boolean; readonly destructive?: boolean };
interface Props { label: string; links: readonly MenuLink[]; summaryLabel?: string; class?: string }
const { label, links, summaryLabel, class: className } = Astro.props;
---
<details class:list={['choice-menu', className]} data-disclosure>
  <summary aria-label={summaryLabel} title={summaryLabel}><slot /></summary>
  <nav class="choice-list" aria-label={label}>
    {links.map((link) => <a href={link.href} aria-current={link.current ? 'true' : undefined} class:list={{ 'destructive-menu-item': link.destructive }}>{link.current && <Icon name="circle-check" size={14} />}<span>{link.label}</span></a>)}
  </nav>
</details>
