---
import type { LibraryPage, ScopeRequest, Workspace } from '@artifacts/artifacts/panel/model';
import { projectTone, searchFor } from '../../presentation.ts';
import { libraryHref } from '../../urls.ts';
import Icon from '../Icon.astro';
interface Props { workspace: Workspace; page: LibraryPage }
const { workspace, page } = Astro.props;
const query = searchFor(page);
const label = page.scope.kind === 'project' ? page.scope.project.name : page.scope.kind === 'vanishedProject' ? page.scope.name : page.scope.kind === 'unfiled' ? 'Sin proyecto' : 'Todos los proyectos';
const choices: readonly { label: string; count: number; scope: ScopeRequest }[] = [
  { label: 'Todos los proyectos', count: workspace.total.count, scope: { kind: 'all' } },
  ...workspace.projects.map(({ name, count }) => ({ label: name, count, scope: { kind: 'project' as const, name } })),
  { label: 'Sin proyecto', count: workspace.unfiled.count, scope: { kind: 'unfiled' } },
];
const isCurrent = (scope: ScopeRequest) => scope.kind === query.scope.kind && (scope.kind !== 'project' || (query.scope.kind === 'project' && scope.name === query.scope.name));
---
<details class="project-filter">
  <summary><Icon name="folder" size={17} /><span>{label}</span><Icon name="chevron-down" size={15} /></summary>
  <nav class="project-filter-links" aria-label="Filtrar por proyecto">
    {choices.map((choice) => <a href={libraryHref(query, { scope: choice.scope })} aria-current={isCurrent(choice.scope) ? 'page' : undefined} title={choice.label}>
      <span class="project-dot" data-tone={choice.scope.kind === 'project' ? projectTone(choice.scope.name) : undefined} aria-hidden="true"></span><span>{choice.label}</span><span class="project-count">{choice.count}</span>
    </a>)}
  </nav>
</details>
