---
import type { ScopeRequest, Workspace } from '@artifacts/artifacts/panel/model';
import { projectTones } from '../../presentation.ts';
import { libraryHref, readerHref, type LibraryLink } from '../../urls.ts';
import Icon from '../Icon.astro';
interface Props { workspace: Workspace; query: LibraryLink; reader?: boolean }
const { workspace, query, reader = false } = Astro.props;
const tone = projectTones(workspace.projects);
const href = (scope: ScopeRequest) => reader ? readerHref(query, { scope }) : libraryHref(query, { scope });
const choices: readonly { label: string; count: number; scope: ScopeRequest }[] = [
  ...workspace.projects.map(({ name, count }) => ({ label: name, count, scope: { kind: 'project' as const, name } })),
  { label: 'Sin proyecto', count: workspace.unfiled.count, scope: { kind: 'unfiled' } },
];
const isCurrent = (scope: ScopeRequest) => scope.kind === query.scope.kind && (scope.kind !== 'project' || (query.scope.kind === 'project' && scope.name === query.scope.name));
---
<nav class="project-filter" aria-label="Filtrar por proyecto">
  {choices.map((choice) => <a href={href(choice.scope)} aria-current={isCurrent(choice.scope) ? 'page' : undefined} aria-label={`${choice.label} (${choice.count})`} title={choice.label}>
    <span class="project-dot" data-tone={choice.scope.kind === 'project' ? tone(choice.scope.name) : undefined} aria-hidden="true"></span><span class="project-name">{choice.label}</span><span class="project-count">{choice.count}</span>
  </a>)}
  {query.scope.kind !== 'all' && <a class="project-filter-clear" href={href({ kind: 'all' })} aria-label={`Todos los proyectos (${workspace.total.count})`} title="Todos los proyectos"><Icon name="x" size={14} /></a>}
</nav>
