---
import type { LibraryPage, Workspace } from '@artifacts/artifacts/panel/model';
import { libraryHref, nextOffset, readerHref, type LibraryLink, type ListView } from '../../urls.ts';
import ArtifactCard from './ArtifactCard.astro';
import ArtifactTable from './ArtifactTable.astro';
import CreateHereCard from './CreateHereCard.astro';
import CreateHereRow from './CreateHereRow.astro';
import SelectionBar from './SelectionBar.astro';
import Icon from '../Icon.astro';
interface Props { page: LibraryPage; workspace: Workspace; query: LibraryLink; cursor: string | undefined; offset: number | undefined; now: Date; view: ListView }
const { page, workspace, query, cursor, offset, now, view } = Astro.props;
const total = page.counts[page.status];
const filtered = Boolean(page.q || page.status !== 'all');
const selectable = page.scope.kind === 'project' || page.scope.kind === 'unfiled';
const clearHref = libraryHref(query, { q: '', status: 'all' });
const reader = (artifactId: string) => readerHref(query, { cursor, offset, artifactId });
const empty = page.continued
  ? { icon: 'layers-intersect', title: 'Llegaste al final de los resultados', text: 'Vuelve al inicio para ver los artefactos más recientes.' } as const
  : filtered
    ? { icon: 'search', title: 'No hay resultados', text: 'Prueba con otro título o cambia los filtros de publicación.' } as const
    : page.scope.kind === 'vanishedProject'
      ? { icon: 'folder', title: 'Este proyecto ya no tiene artefactos', text: 'Un proyecto existe mientras contiene al menos un artefacto.' } as const
      : workspace.total.count === 0
        ? { icon: 'layers-intersect', title: 'Tu próximo proyecto empieza aquí', text: 'Crea tu primer artefacto desde Claude Code o Codex. Aquí podrás revisarlo, descargarlo y publicarlo.' } as const
        : { icon: 'folder', title: 'No hay artefactos sin proyecto', text: 'Todos tus artefactos están organizados en proyectos.' } as const;
---
<section class="library-collection" aria-label="Artefactos">
  {(filtered || page.continued) && page.cards.length > 0 && <div class="library-results">
    <p role="status">{total} {total === 1 ? 'artefacto' : 'artefactos'}{page.q ? <> para <strong>"{page.q}"</strong></> : ''}{page.continued && <span class="results-continuation">, continuación de resultados</span>}</p>
    {filtered && <a class="clear-filters" href={clearHref}>Limpiar filtros</a>}
  </div>}
  {selectable && page.cards.length > 0 && <SelectionBar />}
  {page.cards.length ? view === 'cards'
    ? <ul class="artifact-grid">{page.cards.map((card) => <ArtifactCard card={card} reader={reader(card.artifactId)} now={now} selectable={selectable} />)}{page.scope.kind === 'project' && <CreateHereCard project={page.scope.project.name} />}</ul>
    : <ArtifactTable page={page} workspace={workspace} query={query} reader={reader} now={now} selectable={selectable} />
  : <div class="library-empty" data-slot="card">
    <span class="empty-icon" aria-hidden="true"><Icon name={empty.icon} size={30} /></span><h2>{empty.title}</h2><p>{empty.text}</p>
    {page.continued ? <a class="button secondary" href={libraryHref(query)}>Volver al inicio</a>
      : filtered ? <a class="button secondary" href={clearHref}>Limpiar filtros</a>
      : workspace.total.count === 0 && page.scope.kind !== 'vanishedProject' ? <a class="button secondary" href="#connect-tools" data-open-tools><Icon name="plug-connected" size={18} />Conectar herramientas</a>
      : <a class="button secondary" href="/">Ver todos tus artefactos</a>}
  </div>}
  {view === 'table' && page.cards.length > 0 && page.scope.kind === 'project' && <CreateHereRow project={page.scope.project.name} />}
  {(page.continued && page.cards.length > 0 || page.next) && <div class="library-pagination">
    {page.continued && page.cards.length > 0 && <a class="button secondary" href={libraryHref(query)}>Volver al inicio</a>}
    {page.next && <a class="library-next button secondary" href={libraryHref(query, { cursor: page.next, offset: nextOffset(offset, page) })}>Ver más artefactos<Icon name="chevron-right" size={16} /></a>}
  </div>}
</section>
