---
import { absoluteTime, previewSandbox, publicationStates, relativeTime } from '../../presentation.ts';
import { detailHref, previewHref, shareHref } from '../../urls.ts';
import type { ReaderRow } from './rows.ts';
import PublicationForm from '../PublicationForm.astro';
import Icon from '../Icon.astro';
interface Props { row: ReaderRow; now: Date }
const { row: { card, href, position, previous, next }, now } = Astro.props;
const { publication, head } = card;
const steps = [{ direction: -1, label: 'Anterior', key: 'k', icon: 'chevron-up', href: previous }, { direction: 1, label: 'Siguiente', key: 'j', icon: 'chevron-down', href: next }] as const;
---
<section class="reader-pane" aria-labelledby="reader-title" data-reader-pane>
  <header class="reader-head">
    <div class="reader-head-title">
      <h2 id="reader-title" title={card.title}>{card.title}</h2>
      <p class="reader-head-meta"><span class="artifact-status" data-state={publication.state}>{publicationStates[publication.state].label}</span><span>Rev. {head.sequence}</span><time datetime={head.createdAt.toISOString()} title={absoluteTime(head.createdAt)}>{relativeTime(head.createdAt, now)}</time>{card.slug && <code title={card.slug}>{card.slug}</code>}</p>
    </div>
    <div class="reader-head-actions">
      {position && <span class="reader-position">{position}</span>}
      {steps.map((step) => step.href
        ? <a class="button reader-icon-button" href={step.href} aria-label={step.label} title={`${step.label} (${step.key})`} data-reader-step={step.direction}><Icon name={step.icon} size={15} /></a>
        : <a class="button reader-icon-button" role="link" aria-disabled="true" aria-label={step.label} title={step.label} data-reader-step={step.direction}><Icon name={step.icon} size={15} /></a>)}
      <a class="button reader-labeled-button" href={shareHref(card.artifactId)} data-share-trigger><Icon name="share" size={15} /><span>Compartir</span></a>
      <a class="button reader-labeled-button" href={detailHref({ artifactId: card.artifactId, tab: 'preview' })}><Icon name="external-link" size={15} /><span>Detalle</span></a>
      {publication.state !== 'unpublished' && <a class="button reader-icon-button" href={publication.url} aria-label="Abrir publicación" title="Abrir publicación"><Icon name="world" size={15} /></a>}
      {publication.state === 'pending' && <PublicationForm command={{ artifactId: card.artifactId, revisionId: head.revisionId, expectedPublicationVersion: publication.version, requestId: crypto.randomUUID() }} label={`Publicar rev. ${head.sequence}`} returnPath={href} />}
      <button class="reader-icon-button" type="button" aria-label="Pantalla completa" title="Pantalla completa" data-reader-fullscreen hidden><Icon name="maximize" size={15} /></button>
    </div>
  </header>
  <div class="reader-document">
    <iframe class="reader-preview" title={`Vista previa de ${card.title}`} sandbox={previewSandbox(card.kind)} referrerpolicy="no-referrer" src={previewHref(card.artifactId, head.revisionId)} data-reader-frame></iframe>
  </div>
</section>
