---
import type { NavLocation } from '../../presentation.ts';
import { projectTone, scopeOf } from '../../presentation.ts';
import { scopeHref } from '../../urls.ts';
import Icon from '../Icon.astro';
interface Props { location: NavLocation; title: string }
const { location, title } = Astro.props;
const scope = scopeOf(location);
const nested = location.kind === 'artifact' || location.kind === 'task';
const scoped = scope.kind !== 'all';
const scopeName = scope.kind === 'project' ? scope.name : 'Sin proyecto';
---
<nav class="workspace-breadcrumb" aria-label="Ruta">
  <ol>
    <li>{location.kind === 'library' ? <><Icon name="home" size={17} /><span>Biblioteca</span></> : <a href="/">Biblioteca</a>}</li>
    {scoped && <li><Icon name="chevron-right" size={14} />{nested ? <a href={scopeHref(scope)} title={scopeName}>{scope.kind === 'project' && <span class="project-dot" data-tone={projectTone(scope.name)}></span>}<span>{scopeName}</span></a> : <span title={scopeName}>{scopeName}</span>}</li>}
    {nested && <li><Icon name="chevron-right" size={14} /><span title={title}>{title}</span></li>}
  </ol>
</nav>
