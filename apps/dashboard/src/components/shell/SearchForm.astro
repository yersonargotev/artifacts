---
import { defaultDirections } from '@artifacts/artifacts/panel/model';
import type { LibraryLink } from '../../urls.ts';
import Icon from '../Icon.astro';
import { Input } from '../ui/input.tsx';
interface Props { query: LibraryLink; action: string }
const { query, action } = Astro.props;
const placeholder = query.scope.kind === 'project' ? `Buscar en ${query.scope.name}…` : query.scope.kind === 'unfiled' ? 'Buscar en Sin proyecto…' : 'Buscar artefactos…';
---
<form class="shell-search" role="search" aria-label="Buscar en tus artefactos" method="get" action={action}>
  <Input id="artifact-search" type="search" name="q" defaultValue={query.q} maxLength={256} placeholder={placeholder} aria-label="Buscar artefactos" />
  <button type="submit" aria-label="Buscar" title="Buscar"><Icon name="search" size={15} /></button>
  <button type="button" class="palette-trigger" aria-label="Abrir la paleta de comandos" title="Paleta de comandos" aria-haspopup="dialog" data-palette-open hidden><kbd class="kbd">⌘K</kbd><Icon name="command" size={16} /></button>
  {query.scope.kind === 'project' && <input type="hidden" name="project" value={query.scope.name} />}
  {query.scope.kind === 'unfiled' && <input type="hidden" name="unfiled" value="1" />}
  {query.status !== 'all' && <input type="hidden" name="status" value={query.status} />}
  {query.sort && query.sort !== 'updated' && <input type="hidden" name="sort" value={query.sort} />}
  {query.direction && query.direction !== defaultDirections[query.sort ?? 'updated'] && <input type="hidden" name="dir" value={query.direction} />}
  {query.view && <input type="hidden" name="view" value={query.view} />}
  {query.group && <input type="hidden" name="group" value={query.group} />}
</form>
