---
import type { ArtifactSummary } from '@artifacts/artifacts/contracts';
import ArtifactRowMenu from './ArtifactRowMenu.tsx';
interface Props { items: readonly ArtifactSummary[]; nextCursor?: string | null }
const { items, nextCursor } = Astro.props;
const groups = new Map<string, ArtifactSummary[]>();
for (const artifact of items) {
  const day = artifact.createdAt.slice(0, 10);
  const group = groups.get(day);
  if (group) group.push(artifact);
  else groups.set(day, [artifact]);
}
const date = (value: string) => new Date(value).toLocaleDateString('es', { dateStyle: 'medium', timeZone: 'UTC' });
---
<section class="artifact-library">
  <h1>Tus artefactos</h1>
  {items.length ? Array.from(groups, ([day, artifacts]) => <section class="library-group" aria-label={`Artefactos creados el ${date(day)}`}>
    <h2>Creado el {date(day)}</h2>
    <ul class="artifact-list">{artifacts.map((artifact) => {
      const detailUrl = `/artifacts/${encodeURIComponent(artifact.artifactId)}`;
      return <li>
        <span class="artifact-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v5h4M9 12h6M9 16h6" /></svg></span>
        <div class="artifact-row-content"><h3><a href={detailUrl}>{artifact.title}</a></h3>{artifact.publication && artifact.publication.revisionId !== artifact.headRevisionId && <p class="pending">Cambios pendientes de publicación</p>}<p class="row-created">Creado el {date(artifact.createdAt)}</p></div>
        <span class="row-publication">{artifact.publication ? `Publicado · versión ${artifact.publication.version}` : 'Sin publicar'}</span>
        <ArtifactRowMenu title={artifact.title} actions={[
          { label: 'Ver artefacto', href: detailUrl },
          { label: 'Descargar revisión más reciente', href: `${detailUrl}/export?${new URLSearchParams({ revisionId: artifact.headRevisionId })}` },
          ...(artifact.publication ? [{ label: 'Abrir publicación', href: artifact.publication.url }] : []),
        ]} client:load />
      </li>;
    })}</ul>
  </section>) : <div class="library-empty"><span class="artifact-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v5h4M9 12h6M9 16h6" /></svg></span><h2>Aún no tienes artefactos</h2><p>Crea uno desde Claude Code o Codex con las herramientas de Artifacts.</p></div>}
  {nextCursor && <a class="library-next" href={`/?${new URLSearchParams({ cursor: nextCursor })}`}>Ver más artefactos</a>}
</section>
