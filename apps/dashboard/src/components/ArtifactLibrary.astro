---
import type { LibraryPage } from '@artifacts/artifacts/panel/model';
import { libraryHref, scopeRequestOf } from '../urls.ts';
import ArtifactRowMenu from './ArtifactRowMenu.tsx';
import Icon from './Icon.astro';
import { Badge } from './ui/badge.tsx';
interface Props { page: LibraryPage }
const { page } = Astro.props;
const { cards: items, next: nextCursor, counts, continued } = page;
const query = { scope: scopeRequestOf(page.scope), q: page.q, status: page.status };
const project = page.scope.kind === 'project' ? page.scope.project.name : page.scope.kind === 'vanishedProject' ? page.scope.name : undefined;
const unfiled = page.scope.kind === 'unfiled';
const filters = [{ value: 'all', label: 'Todos' }, { value: 'published', label: 'Publicados' }, { value: 'unpublished', label: 'Sin publicar' }, { value: 'pending', label: 'Cambios pendientes' }] as const;
const urlFor = (status = query.status, cursor?: string, q = query.q) => libraryHref(query, { status, cursor, q });
const total = counts[query.status];
const filtered = Boolean(query.q || query.status !== 'all');
const empty = filtered ? { icon: 'search', title: 'No hay resultados', text: 'Prueba con otro título o cambia los filtros de publicación.', link: { href: urlFor('all', undefined, ''), label: 'Limpiar búsqueda y filtros' } } as const
  : project ? { icon: 'folder', title: 'Este proyecto ya no tiene artefactos', text: 'Un proyecto existe mientras contiene al menos un artefacto.', link: { href: '/', label: 'Ver todos tus artefactos' } } as const
  : { icon: 'layers-intersect', title: 'Tu próximo proyecto empieza aquí', text: 'Crea tu primer artefacto desde Claude Code o Codex. Aquí podrás revisarlo, descargarlo y publicarlo.', link: undefined } as const;
const date = (value: Date) => value.toLocaleDateString('es', { dateStyle: 'medium', timeZone: 'UTC' });
const relative = (value: Date) => {
  const minutes = Math.round((value.getTime() - Date.now()) / 60_000);
  const formatter = new Intl.RelativeTimeFormat('es', { numeric: 'auto' });
  return Math.abs(minutes) < 60 ? formatter.format(minutes, 'minute') : Math.abs(minutes) < 1_440 ? formatter.format(Math.round(minutes / 60), 'hour') : formatter.format(Math.round(minutes / 1_440), 'day');
};
---
<section class="artifact-library">
  <div class="library-heading"><div><h1>{unfiled ? 'Sin proyecto' : project ?? 'Biblioteca'}</h1><p>{unfiled ? 'Los artefactos que aún no tienen proyecto.' : project ? 'Los artefactos de este proyecto.' : 'Todo lo que creas, en un solo lugar.'}</p></div><button class="button connect-button" type="button" aria-label="Conectar herramientas" data-open-tools><Icon name="plug-connected" size={18} /><span>Conectar herramientas</span></button></div>
  <nav class="library-filters" aria-label="Filtrar por publicación">{filters.map(({ value, label }) => <a href={urlFor(value)} aria-current={query.status === value ? 'page' : undefined} aria-label={`${label} (${counts[value]})`}>{label}<span>{counts[value]}</span></a>)}</nav>
  <div class="library-results"><p role="status">{total} {total === 1 ? 'artefacto' : 'artefactos'}{query.q ? <> para <strong>"{query.q}"</strong></> : ''}{continued && total > 0 ? <span class="results-continuation">, continuación de resultados</span> : ''}</p>{filtered && <a class="clear-filters" href={urlFor('all', undefined, '')}>Limpiar filtros</a>}</div>
  {items.length ? <div class="library-card" data-slot="card"><div class="library-table-heading" aria-hidden="true"><span>Nombre</span><span>Publicación</span><span>Actualizado</span><span></span></div><ul class="artifact-list">{items.map((artifact) => {
    const detailUrl = `/artifacts/${encodeURIComponent(artifact.artifactId)}`;
    const publication = artifact.publication.state === 'unpublished' ? undefined : artifact.publication;
    const pending = publication?.state === 'pending';
    return <li>
      <span class="artifact-icon" aria-hidden="true"><Icon name="file-text" size={23} /></span>
      <div class="artifact-row-content"><h2><a href={detailUrl}>{artifact.title}</a></h2>{pending ? <p class="pending"><span></span>Cambios pendientes de publicación</p> : <p class="row-kind">{artifact.project ?? 'Artefacto'}</p>}<p>Revisión {artifact.head.sequence} · Actualizado {relative(artifact.head.createdAt)}</p></div>
      <div class="row-publication"><Badge className={publication ? 'publication-badge is-published' : 'publication-badge'}>{publication ? <><Icon name="world" size={13} />Publicada</> : 'Sin publicar'}</Badge>{publication && <span class="publication-version">Publicada · revisión {publication.revision.sequence}</span>}</div>
      <time class="row-created" datetime={artifact.head.createdAt.toISOString()}>{date(artifact.head.createdAt)}</time>
      <ArtifactRowMenu title={artifact.title} deleteUrl={`${detailUrl}/delete`} actions={[
        { label: 'Ver artefacto', href: detailUrl },
        { label: 'Descargar revisión más reciente', href: `${detailUrl}/export?${new URLSearchParams({ revisionId: artifact.head.revisionId })}` },
        ...(publication ? [{ label: 'Abrir publicación', href: publication.url }] : []),
        { label: 'Mover a proyecto', href: `${detailUrl}/move` },
      ]} client:load />
    </li>;
  })}</ul></div> : <div class="library-empty" data-slot="card"><span class="empty-icon"><Icon name={empty.icon} size={30} /></span><h2>{empty.title}</h2><p>{empty.text}</p>{empty.link ? <a class="button secondary" href={empty.link.href}>{empty.link.label}</a> : <button type="button" data-open-tools><Icon name="plug-connected" size={18} />Conectar herramientas</button>}</div>}
  <div class="library-pagination">{continued && <a class="secondary button" href={urlFor()}>Volver al inicio</a>}{nextCursor && <a class="library-next secondary button" href={urlFor(query.status, nextCursor)}>Ver más artefactos<Icon name="chevron-right" size={16} /></a>}</div>
</section>
