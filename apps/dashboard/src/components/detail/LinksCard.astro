---
import { brokenLinkLabels, type BrokenPageLink } from '@artifacts/artifacts/panel/model';
interface Props { links: readonly BrokenPageLink[] }
const { links } = Astro.props;
---
<section class="detail-card links-card" aria-labelledby="links-title">
  <h2 id="links-title">Enlaces</h2>
  <p class="muted">{links.length === 1 ? 'Este enlace relativo no lleva a ninguna página del proyecto.' : 'Estos enlaces relativos no llevan a ninguna página del proyecto.'}</p>
  <ul>
    {links.map(({ href, text, target }) => <li data-link-state="broken"><span>{text || href}</span><span class="badge">{brokenLinkLabels[target.reason]}</span><code>{href}</code></li>)}
  </ul>
</section>
