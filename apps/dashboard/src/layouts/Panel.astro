---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/panel.css';
import '../styles/effects.css';
import '../styles/views.css';
import type { Workspace } from '@artifacts/artifacts/panel/model';
import { readerHref, scopeHref, type LibraryLink } from '../urls.ts';
import ShareDialog from '../components/share/ShareDialog.tsx';
import MoveDialog from '../components/move/MoveDialog.tsx';
import Rail from '../components/shell/Rail.astro';
import Breadcrumb from '../components/shell/Breadcrumb.astro';
import SearchForm from '../components/shell/SearchForm.astro';
import StatusBar from '../components/shell/StatusBar.astro';
import Palette from '../components/palette/Palette.tsx';
import type { PaletteData } from '../components/palette/entries.ts';
import { projectTones, scopeOf, type NavLocation } from '../presentation.ts';
import { getRuntime } from '../runtime.ts';
import { readTheme, themeColors, themeCookie } from '../theme.ts';
import Icon from '../components/Icon.astro';
/**
 * `back` adds a back link before the breadcrumb and makes the title the page heading. `summary` replaces the workspace totals in the status bar.
 * `artifacts` are the page's own artifacts for the command palette, and `readerKey` says that `r` opens read mode here.
 */
interface Props { title?: string; workspace?: Workspace; location?: NavLocation; search?: LibraryLink; move?: boolean; share?: boolean; flush?: boolean; back?: { href: string; label: string }; summary?: string; artifacts?: PaletteData['artifacts']; readerKey?: boolean }
const { title = 'Biblioteca', workspace, location = { kind: 'task' }, search, move = false, share = false, flush = false, back, summary, artifacts = [], readerKey = false } = Astro.props;
const identity = Astro.locals.identity;
const authUrl = identity ? (await getRuntime()).config.auth : '';
const query = search ?? { scope: scopeOf(location), q: '', status: 'all' };
const theme = readTheme(Astro.cookies.get(themeCookie)?.value);
const topLevel = location.kind === 'library' || location.kind === 'projects';
const reader = readerHref({ scope: scopeOf(location), status: 'all', q: '' });
const tone = projectTones(workspace?.projects ?? []);
const palette: PaletteData = { artifacts, projects: (workspace?.projects ?? []).map(({ name, count }) => ({ name, count, tone: tone(name), href: scopeHref({ kind: 'project', name }) })), reader, readerKey };
---
<!doctype html>
<html lang="es" data-theme={theme}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content={themeColors[theme]} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title} · Artifacts</title><script is:inline src="/views.js"></script></head>
  <body class:list={['panel', { 'app-shell': Boolean(identity), 'reader-shell': location.kind === 'read' }]}>
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    {identity && <Rail identity={identity} authUrl={authUrl} location={location} theme={theme} reader={reader} />}
    <div class="app-column">
      {identity ? <header class="top-bar">
        {topLevel ? <h1 id="page-title">{title}</h1> : back ? <>
          <a class="top-bar-back" href={back.href} aria-label={back.label} title={back.label}><Icon name="chevron-left" size={16} /></a>
          <Breadcrumb location={location} title={title} tone={tone} heading /><h1 id="page-title">{title}</h1>
        </> : <Breadcrumb location={location} title={title} tone={tone} />}
        <SearchForm query={query} action={location.kind === 'read' ? '/read' : '/'} />
        {Astro.slots.has('bar') && <div class="top-bar-actions"><slot name="bar" /></div>}
      </header> : <header class="panel-header"><a class="wordmark" href="/">Artifacts</a><span>Biblioteca</span></header>}
      <main class="panel-main" id="main-content" data-flush={flush ? '' : undefined}><slot /></main>
      {identity && <StatusBar workspace={workspace} summary={summary}><slot name="status" /></StatusBar>}
    </div>
    {identity && <><Palette data={JSON.stringify(palette)} client:load /><dialog class="publish-dialog" aria-labelledby="publish-dialog-title" data-publish-dialog></dialog></>}
    {share && <ShareDialog client:load />}
    {move && workspace && <MoveDialog projects={JSON.stringify(workspace.projects.map(({ name }) => name))} client:load />}
  </body>
</html>
