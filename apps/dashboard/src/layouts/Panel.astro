---
const { title = 'Tu espacio', section = 'Tu espacio' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title} · Artifacts</title></head>
  <body><header><a class="wordmark" href="/">Artifacts</a><span>{section}</span></header><main><slot /></main></body>
</html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#eaf0f5;color:#132943;font-family:Optima,Candara,'Segoe UI',sans-serif;font-size:17px}header{display:flex;align-items:center;justify-content:space-between;padding:28px clamp(24px,6vw,88px);border-bottom:1px solid #c7d5e3}.wordmark{font-size:28px;font-weight:600;letter-spacing:-1px;text-decoration:none;color:#132943}header span{color:#48617b}main{max-width:1080px;margin:0 auto;padding:60px 32px 36px}h1{font-size:clamp(34px,5vw,58px);font-weight:500;letter-spacing:-1.5px;line-height:1.08;margin:0 0 24px}h2{font-size:25px;font-weight:500;margin:0 0 14px}p{line-height:1.6;max-width:58ch}a{color:#2546c0}.welcome{margin-bottom:48px}.welcome>p{max-width:48ch}.identity{display:grid;grid-template-columns:160px 1fr;align-items:center;gap:40px;padding:36px;background:white;border-radius:8px}.monogram{font-family:Georgia,serif;font-size:142px;line-height:1;color:#3154d9;letter-spacing:-12px}.identity p{margin-top:0;color:#48617b}code{display:block;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,monospace;font-size:14px;line-height:1.6;background:#eaf0f5;padding:14px 16px;border-radius:4px}dl{display:grid;grid-template-columns:auto 1fr;gap:8px 24px;margin-bottom:0}dt{color:#48617b}dd{margin:0;overflow-wrap:anywhere}.tools{margin:40px 0 48px;max-width:720px}.tools code{border:1px solid #b6c8d9;background:transparent}footer{border-top:1px solid #c7d5e3;padding-top:28px;display:flex;align-items:center;gap:32px;margin-top:40px}button,.button{display:inline-block;font:inherit;text-decoration:none;border:0;border-radius:4px;background:#3154d9;color:white;padding:14px 22px;cursor:pointer}.secondary{background:transparent;color:#132943;border:1px solid #9baec2}a:focus-visible,button:focus-visible{outline:3px solid #6885ff;outline-offset:4px}.logged-out .monogram{font-size:120px;margin-bottom:35px}.logged-out{max-width:700px}.logged-out p{margin-bottom:30px}[role=alert]{color:#a32035}.artifacts{margin:48px 0}.artifact-list,.revision-list{list-style:none;padding:0;margin:24px 0}.artifact-list li,.revision-list li{padding:24px 0;border-top:1px solid #c7d5e3}.artifact-list h3{margin:0 0 10px;font-weight:500;font-size:24px}.artifact-list p,.revision-list p{margin:8px 0;color:#48617b}.actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center}.badge{display:inline-block;border:1px solid #9baec2;border-radius:4px;padding:4px 9px;font-size:14px}.preview{display:block;width:100%;height:70vh;min-height:400px;border:0;background:white;border-radius:8px;margin:24px 0}.revision-list .actions{margin-top:14px}.muted{color:#48617b}.back{display:inline-block;margin-bottom:28px}.publication{padding:26px;background:white;border-radius:8px;margin-bottom:36px}.publication code{margin-top:14px}.revision-title{display:flex;flex-wrap:wrap;align-items:center;gap:12px}.revision-title h3{margin:0;font-size:21px;font-weight:500}@media(max-width:620px){header{padding:22px 24px}main{padding:40px 24px}.identity{grid-template-columns:1fr;gap:18px;padding:26px}.identity .monogram{font-size:82px}footer{align-items:flex-start;flex-direction:column;gap:24px}dl{grid-template-columns:1fr;gap:7px}dd+dt{margin-top:10px}.tools{margin-bottom:34px}.actions{align-items:flex-start;gap:14px}.publication{padding:22px}}
</style>
<style is:global>
.artifact-list h3,.artifact-detail h1,.artifact-detail p,.comparison h4{overflow-wrap:anywhere}
.artifact-detail{min-width:0}.inventory,.comparison{margin-top:44px}.revision-state{margin:20px 0}.revision-state code{padding:6px 0;background:transparent}.publication .publish-form{margin-top:20px}.pending{margin-left:8px;background:#f9f2d9}.table-scroll{max-width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:15px;table-layout:fixed}th,td{text-align:left;vertical-align:top;border-top:1px solid #c7d5e3;padding:14px 12px;overflow-wrap:anywhere}thead th{color:#48617b;font-weight:500}table code{padding:0;background:transparent;font-size:12px}table pre,.content-comparison pre{white-space:pre-wrap;overflow-wrap:anywhere;font:14px/1.6 ui-monospace,SFMono-Regular,monospace;margin:0;max-height:420px;overflow:auto}.compare-form{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin:20px 0}.compare-form select{max-width:100%;min-width:0;padding:12px;border:1px solid #9baec2;background:white;color:#132943;font:inherit;border-radius:4px}.compare-form select:focus-visible{outline:3px solid #6885ff;outline-offset:4px}.content-comparison,.file-comparison{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}.content-comparison pre{padding:18px;background:white;border-radius:4px}.comparison h3{margin-top:30px;font-weight:500}.comparison h4{font-size:17px;font-weight:500;margin:14px 0}.file-changes{list-style:none;padding:0}.file-changes li{border-top:1px solid #c7d5e3;padding:12px 0}.file-comparison p{margin:6px 0;overflow-wrap:anywhere}.inventory th:first-child{width:25%}.inventory th:nth-child(2){width:25%}.inventory th:nth-child(3){width:10%}.inventory th:nth-child(4){width:40%}@media(max-width:620px){.pending{margin:8px 0 0}.content-comparison,.file-comparison{grid-template-columns:minmax(0,1fr);gap:12px}.compare-form{align-items:stretch;flex-direction:column}.table-scroll table{min-width:560px}.publication h1{font-size:34px}.publication-state{overflow-wrap:anywhere}}
</style>
