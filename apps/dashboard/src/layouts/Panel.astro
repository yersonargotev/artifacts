---
import '../styles/panel.css';
const { title = 'Tus artefactos', section = 'Tus artefactos', library = false } = Astro.props;
---
<!doctype html>
<html lang="es" class="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title} · Artifacts</title></head>
  <body class:list={['panel', { 'library-shell': library }]}>
    {library ? <aside class="library-sidebar"><slot name="sidebar" /></aside> : <slot name="header"><header class="panel-header"><a class="wordmark" href="/">Artifacts</a><span>{section}</span></header></slot>}
    <main class="panel-main"><slot /></main>
  </body>
</html>
