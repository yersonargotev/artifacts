DATABASE_URL=file:/absolute/path/to/artifacts/.data/identity.db
DATABASE_AUTH_TOKEN=
AUTH_URL=http://localhost:4100
MCP_URL=http://127.0.0.1:4101/mcp
DASHBOARD_URL=http://127.0.0.1:4321
PUBLISH_URL=http://[::1]:4102
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLICATION_SERVICE_SECRET=replace-with-at-least-32-random-characters
PUBLICATION_COOKIE_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.test
OWNER_NAME=Your name
OWNER_PASSWORD=replace-with-a-long-random-password
PANEL_CLIENT_ID=created-by-identity-bootstrap
PANEL_CLIENT_SECRET=created-by-identity-bootstrap
MCP_INTROSPECTION_CLIENT_ID=created-by-identity-bootstrap
MCP_INTROSPECTION_CLIENT_SECRET=created-by-identity-bootstrap
AUTH_BIND_HOST=127.0.0.1
AUTH_PORT=4100
MCP_BIND_HOST=127.0.0.1
MCP_PORT=4101

# Email-code sign-in is opt-in. Leave EMAIL_TRANSPORT unset for legacy password/OAuth.
# For local delivery, set file and a private absolute path with an existing parent directory.
# EMAIL_TRANSPORT=file
# EMAIL_FILE_PATH=/tmp/artifacts-email.jsonl
# Resend requires a verified sender domain. Auth also requires OWNER_EMAIL.
# EMAIL_TRANSPORT=resend
# EMAIL_FROM=codes@example.com
# RESEND_API_KEY=
