{
  "name": "artifacts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm --filter @artifacts/dashboard check",
    "build": "pnpm --filter @artifacts/dashboard build",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "pnpm --filter @artifacts/db generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "configure": "tsx scripts/configure.ts",
    "identity:bootstrap": "tsx apps/auth/src/bootstrap.ts",
    "dev:auth": "tsx apps/auth/src/server.ts",
    "dev:mcp": "tsx apps/mcp/src/server.ts",
    "dev:dashboard": "tsx scripts/dashboard.ts",
    "test:browser": "pnpm build && node --import tsx tests/browser.proof.ts",
    "verify:turso": "tsx scripts/verify-turso.ts",
    "dev": "tsx scripts/dev.ts"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.4",
    "@libsql/client": "0.18.0",
    "@types/node": "24.10.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "playwright": "1.64.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
